# ===========================================================================
# Beispiel-Konfiguration fuer die WebRTC Remote-Guidance-Plattform
#
# VERWENDUNG
#   cp .env.example .env
#   danach die Werte eintragen. Die .env selbst gehoert NICHT ins
#   Repository - .gitignore schliesst sie ueber "*.env" aus.
#
# WICHTIG
#   config/env.php laedt die .env mit Dotenv::load(). Fehlt die Datei
#   komplett, bricht die Anwendung bereits beim Start ab. Eine .env muss
#   also existieren, auch wenn nur ein Teil der Funktionen genutzt wird.
#
#   Bis auf LOG_PATH werden alle Schluessel im Code OHNE Absicherung
#   gelesen (z.B. $_ENV['DB_HOST'] statt $_ENV['DB_HOST'] ?? ...). Ein
#   fehlender Schluessel erzeugt eine PHP-Warning, die der Error-Handler
#   in config/error_handler.php zu einem HTTP 500 macht. Die Fehlermeldung
#   im Browser lautet nur "Interner Serverfehler." - die Ursache steht im
#   Logfile.
# ===========================================================================


# ---------------------------------------------------------------------------
# Datenbank  (PFLICHT - ohne diese Werte laeuft gar nichts)
#
# Gelesen in class/Model/PdoConnect.php:29-33. Die Verbindung wird in
# index.php:25 bei JEDEM Request aufgebaut. Fehlt einer dieser fuenf
# Schluessel, antwortet die komplette Anwendung mit HTTP 500 - auch die
# Startseite.
# Erwartet wird MySQL oder MariaDB; das Schema liegt in database.sql.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=webrtc_proj
DB_USER=webrtc_user
DB_PW=hier_das_datenbank_passwort_eintragen


# ---------------------------------------------------------------------------
# Sicherheit  (PFLICHT)
#
# PEPPER ist ein geheimer Zusatzschluessel, der VOR dem Hashen per HMAC in
# das Passwort eingerechnet wird (class/Model/User.php:514). Zusaetzlich
# dient er als AES-Schluessel fuer die Verschluesselung der
# 2FA-Secrets (class/Controller/TwoFactorController.php:225/230).
#
# Fehlt er, schlagen Login (User.php:204), Registrierung (User.php:514),
# Passwortaenderung (PasswordController.php:186) und die komplette
# 2FA-Verwaltung mit HTTP 500 fehl. Die im Code vorhandene Pruefung
# "if (!$pepper)" greift dabei NICHT - die Zeile davor loest den Fehler
# bereits aus.
#
# ACHTUNG - der Wert darf sich NIE aendern:
#   * Alle bestehenden Passwoerter werden unbrauchbar, niemand kann sich
#     mehr anmelden.
#   * Alle hinterlegten 2FA-Secrets lassen sich nicht mehr entschluesseln.
# Ein Wechsel ginge nur mit einem erzwungenen Passwort-Reset fuer alle
# Konten und einer Neueinrichtung der 2FA.
#
# Einen sicheren Wert erzeugen:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# ---------------------------------------------------------------------------
PEPPER=hier_einen_zufaelligen_32_byte_hexstring_eintragen


# ---------------------------------------------------------------------------
# TURN-Server  (PFLICHT fuer Video- und Audioanrufe)
#
# Zugangsdaten fuer Metered.ca. Der Server holt damit kurzlebige
# TURN-Credentials ab (class/Model/MeteredTurnService.php:30-36) und gibt
# nur diese an den Browser weiter - der API-Key selbst verlaesst den
# Server nie.
#
# Fehlen die Werte, liefert die Route get_turn_credentials weiterhin eine
# verwertbare Antwort - allerdings nur mit den STUN-Servern aus STUN_SERVERS
# (siehe unten) und mit "turnAvailable": false. Anrufe sind dann nur noch
# moeglich, wenn beide Seiten in einfachen Netzen sitzen; hinter
# symmetrischem NAT kommt ohne TURN keine Verbindung zustande. Der Nutzer
# bekommt dazu einen Hinweis im Call angezeigt.
#
# APP_NAME ist der Subdomain-Teil der Metered-URL:
#   https://<APP_NAME>.metered.live/api/v1/turn/credentials
# ---------------------------------------------------------------------------
METERED_APP_NAME=meineapp
METERED_API_KEY=hier_den_metered_api_key_eintragen


# ---------------------------------------------------------------------------
# STUN-Server  (OPTIONAL)
#
# Kommagetrennte Liste, gelesen in class/Model/IceServerConfig.php. Diese
# Server werden IMMER zusaetzlich zu den TURN-Zugangsdaten ausgeliefert.
# Zweck: Der Ausfall eines einzelnen Servers - auch der des TURN-Anbieters -
# soll die Verbindung nicht verhindern.
#
# Ist die Variable leer oder nicht gesetzt, gelten diese Vorgaben:
#   stun:stun.l.google.com:19302, stun:stun1.l.google.com:19302,
#   stun:stun.cloudflare.com:3478
#
# Fuer den spaeteren Wechsel auf einen eigenen Server (z. B. coturn) hier
# einfach die eigene Adresse eintragen. Die oeffentlichen Server koennen als
# Rueckfallebene stehen bleiben - mehrere Anbieter sind Absicht, damit der
# Ausfall eines Betreibers nicht alle Eintraege gleichzeitig trifft:
#   STUN_SERVERS=stun:stun.meine-domain.de:3478,stun:stun.l.google.com:19302
#
# Erlaubt sind nur stun:- und stuns:-URLs. Ungueltige Eintraege werden
# ignoriert und protokolliert. TURN-Zugaenge gehoeren NICHT hierher, die
# kommen mit kurzlebigen Credentials vom TURN-Dienst.
# ---------------------------------------------------------------------------
#STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478


# ---------------------------------------------------------------------------
# E-Mail / SMTP  (PFLICHT, sobald Passwort-Reset genutzt wird)
#
# Gelesen in class/Model/Email.php:35-42, verschickt ueber PHPMailer mit
# STARTTLS. SMTP_USERNAME dient zugleich als Absenderadresse.
#
# Fehlt einer der vier Werte, liefert "Passwort vergessen" HTTP 500. Der
# try/catch in Email.php faengt das NICHT ab, weil eine PHP-Warning keine
# Exception ist. Alle uebrigen Funktionen sind nicht betroffen.
#
# Hinweis: Der Versand der Bestaetigungsmail bei der Registrierung ist
# derzeit auskommentiert (SignupController.php), ebenso die
# Verifizierungspflicht beim Login (LoginController.php:65-74). SMTP wird
# also aktuell nur fuer den Passwort-Reset gebraucht.
# ---------------------------------------------------------------------------
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=hier_das_smtp_passwort_eintragen


# ---------------------------------------------------------------------------
# Logging  (OPTIONAL - einziger Schluessel, der fehlen darf)
#
# Vollstaendiger Pfad zur Logdatei, ausgewertet in config/log_path.php:88.
# Fehlt der Wert, greift der Fallback ../logs/php-error.log, also ein
# Verzeichnis OBERHALB des Document Root. Das Verzeichnis wird beim ersten
# Schreiben automatisch mit den Rechten 0750 angelegt.
#
# ACHTUNG - hier in der .env wirkt der Wert NICHT:
#   index.php laedt config/error_handler.php in Zeile 3, config/env.php
#   aber erst in Zeile 9. Zum Zeitpunkt der Pfadermittlung ist die .env
#   also noch gar nicht eingelesen. LOG_PATH muss auf Server- oder
#   Systemebene gesetzt werden:
#     Apache : SetEnv LOG_PATH /var/log/webrtc/php-error.log
#     nginx  : fastcgi_param LOG_PATH /var/log/webrtc/php-error.log;
#     Docker : environment: LOG_PATH=/var/log/webrtc/php-error.log
#   Der Eintrag steht hier nur zur Dokumentation. Ohne ihn ist alles in
#   Ordnung - der Fallback greift.
# ---------------------------------------------------------------------------
#LOG_PATH=/var/log/webrtc/php-error.log


# ---------------------------------------------------------------------------
# APP_ENV  (WIRD NICHT VERWENDET)
#
# In der README als Schluessel aufgefuehrt, aber an keiner Stelle im Code
# ausgelesen. Der Eintrag steht hier auskommentiert, damit beim Vergleich
# mit der README nicht der Eindruck entsteht, er fehle versehentlich.
# Setzen oder Weglassen hat keinerlei Wirkung.
# ---------------------------------------------------------------------------
#APP_ENV=production
