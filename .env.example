# ===========================================================================
# Beispiel-Konfiguration fuer die WebRTC Remote-Guidance-Plattform
#
# VERWENDUNG
#   cp .env.example .env
#   danach die Werte eintragen. Die .env selbst gehoert NICHT ins
#   Repository - .gitignore schliesst sie ueber "*.env" aus.
#
# WICHTIG
#   config/env.php laedt die .env mit Dotenv::load(). Fehlt die Datei
#   komplett, bricht die Anwendung bereits beim Start ab. Eine .env muss
#   also existieren, auch wenn nur ein Teil der Funktionen genutzt wird.
#
#   Bis auf LOG_PATH, UPLOAD_PATH, APP_BASE_URL, MAIL_ENABLED,
#   MAIL_VERIFY_REQUIRED, FORCE_HTTPS, TRUST_PROXY, HSTS_MAX_AGE,
#   HSTS_INCLUDE_SUBDOMAINS und CSP_MODE werden alle Schluessel im Code OHNE
#   Absicherung gelesen (z.B. $_ENV['DB_HOST'] statt $_ENV['DB_HOST'] ?? ...).
#   Ein fehlender Schluessel erzeugt eine PHP-Warning, die der Error-Handler
#   in config/error_handler.php zu einem HTTP 500 macht. Die Fehlermeldung
#   im Browser lautet nur "Interner Serverfehler." - die Ursache steht im
#   Logfile.
# ===========================================================================


# ---------------------------------------------------------------------------
# Datenbank  (PFLICHT - ohne diese Werte laeuft gar nichts)
#
# Gelesen in class/Model/PdoConnect.php:29-33. Die Verbindung wird in
# index.php:25 bei JEDEM Request aufgebaut. Fehlt einer dieser fuenf
# Schluessel, antwortet die komplette Anwendung mit HTTP 500 - auch die
# Startseite.
# Erwartet wird MySQL oder MariaDB; das Schema liegt in database.sql.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=webrtc_proj
DB_USER=webrtc_user
DB_PW=hier_das_datenbank_passwort_eintragen


# ---------------------------------------------------------------------------
# Oeffentliche Adresse der Installation  (PFLICHT, sobald Mails verschickt
# werden - also fuer Passwort-Reset und E-Mail-Bestaetigung)
#
# Die Basisadresse, unter der diese Anwendung im Browser erreichbar ist -
# ohne Schraegstrich am Ende, mit Unterverzeichnis, falls sie nicht direkt
# im Wurzelverzeichnis liegt:
#   APP_BASE_URL=https://example.org
#   APP_BASE_URL=https://example.org/rctproj
#
# Gelesen in class/Helper/Url.php. Daraus baut der Server die Links, die in
# E-Mails gehen:
#   PasswordController.php          Link zum Zuruecksetzen des Passworts
#   EmailVerificationController.php Link zum Bestaetigen der E-Mail-Adresse
#
# Vorher stand in beiden Dateien fest "https://localhost/rctprojnew/" - die
# Adresse eines Entwicklungsrechners. Auf jedem echten Server verwies der
# Link damit ins Leere; der Empfaenger landete auf seinem eigenen localhost
# und konnte sein Passwort nicht zuruecksetzen.
#
# WARUM DAS NICHT AUS DER ANFRAGE KOMMT
#   Naheliegend waere $_SERVER['HTTP_HOST']. Der Host-Header stammt aber vom
#   Aufrufer. Wer "Passwort vergessen" fuer ein fremdes Konto anstoesst und
#   dabei einen eigenen Host mitschickt, bekaeme einen Reset-Link auf den
#   eigenen Server geschrieben: Die Mail ginge an den richtigen Empfaenger,
#   der Klick aber an den Angreifer. Deshalb setzt diesen Wert nur der
#   Betreiber, hier.
#
# FEHLT DER WERT ODER IST ER UNBRAUCHBAR
#   Dann wird KEINE Mail verschickt und kein Token angelegt - ein falscher
#   Link ist schlimmer als keine Mail. Nach aussen bleibt die Antwort
#   unveraendert (beim Passwort-Reset ist sie ohnehin fuer jede Eingabe
#   dieselbe), der Grund steht im Logfile. Anders als bei den uebrigen
#   Schluesseln gibt es hier also KEINEN HTTP 500, sondern eine Funktion,
#   die stumm nichts tut - deshalb der Blick ins Log, wenn keine Mail
#   ankommt.
#
#   Geprueft wird auf http:// oder https:// mit Hostnamen; "?" und "#"
#   sind nicht erlaubt, weil hinter die Basis noch der Token gehaengt wird.
#   Die Anwendung erzwingt HTTPS (index.php), eine http-Adresse wuerde also
#   ohnehin nur weitergeleitet.
# ---------------------------------------------------------------------------
APP_BASE_URL=https://example.org/rctproj


# ---------------------------------------------------------------------------
# Sicherheit  (PFLICHT)
#
# PEPPER ist ein geheimer Zusatzschluessel, der VOR dem Hashen per HMAC in
# das Passwort eingerechnet wird (class/Model/User.php:514). Zusaetzlich
# dient er als AES-Schluessel fuer die Verschluesselung der
# 2FA-Secrets (class/Controller/TwoFactorController.php:225/230).
#
# Fehlt er, schlagen Login (User.php:204), Registrierung (User.php:514),
# Passwortaenderung (PasswordController.php:186) und die komplette
# 2FA-Verwaltung mit HTTP 500 fehl. Die im Code vorhandene Pruefung
# "if (!$pepper)" greift dabei NICHT - die Zeile davor loest den Fehler
# bereits aus.
#
# ACHTUNG - der Wert darf sich NIE aendern:
#   * Alle bestehenden Passwoerter werden unbrauchbar, niemand kann sich
#     mehr anmelden.
#   * Alle hinterlegten 2FA-Secrets lassen sich nicht mehr entschluesseln.
# Ein Wechsel ginge nur mit einem erzwungenen Passwort-Reset fuer alle
# Konten und einer Neueinrichtung der 2FA.
#
# Einen sicheren Wert erzeugen:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# ---------------------------------------------------------------------------
PEPPER=hier_einen_zufaelligen_32_byte_hexstring_eintragen


# ---------------------------------------------------------------------------
# TURN-Server  (PFLICHT fuer Video- und Audioanrufe)
#
# Zugangsdaten fuer Metered.ca. Der Server holt damit kurzlebige
# TURN-Credentials ab (class/Model/MeteredTurnService.php:30-36) und gibt
# nur diese an den Browser weiter - der API-Key selbst verlaesst den
# Server nie.
#
# Fehlen die Werte, liefert die Route get_turn_credentials weiterhin eine
# verwertbare Antwort - allerdings nur mit den STUN-Servern aus STUN_SERVERS
# (siehe unten) und mit "turnAvailable": false. Anrufe sind dann nur noch
# moeglich, wenn beide Seiten in einfachen Netzen sitzen; hinter
# symmetrischem NAT kommt ohne TURN keine Verbindung zustande. Der Nutzer
# bekommt dazu einen Hinweis im Call angezeigt.
#
# APP_NAME ist der Subdomain-Teil der Metered-URL:
#   https://<APP_NAME>.metered.live/api/v1/turn/credentials
# ---------------------------------------------------------------------------
METERED_APP_NAME=meineapp
METERED_API_KEY=hier_den_metered_api_key_eintragen


# ---------------------------------------------------------------------------
# STUN-Server  (OPTIONAL)
#
# Kommagetrennte Liste, gelesen in class/Model/IceServerConfig.php. Diese
# Server werden IMMER zusaetzlich zu den TURN-Zugangsdaten ausgeliefert.
# Zweck: Der Ausfall eines einzelnen Servers - auch der des TURN-Anbieters -
# soll die Verbindung nicht verhindern.
#
# Ist die Variable leer oder nicht gesetzt, gelten diese Vorgaben:
#   stun:stun.l.google.com:19302, stun:stun1.l.google.com:19302,
#   stun:stun.cloudflare.com:3478
#
# Fuer den spaeteren Wechsel auf einen eigenen Server (z. B. coturn) hier
# einfach die eigene Adresse eintragen. Die oeffentlichen Server koennen als
# Rueckfallebene stehen bleiben - mehrere Anbieter sind Absicht, damit der
# Ausfall eines Betreibers nicht alle Eintraege gleichzeitig trifft:
#   STUN_SERVERS=stun:stun.meine-domain.de:3478,stun:stun.l.google.com:19302
#
# Erlaubt sind nur stun:- und stuns:-URLs. Ungueltige Eintraege werden
# ignoriert und protokolliert. TURN-Zugaenge gehoeren NICHT hierher, die
# kommen mit kurzlebigen Credentials vom TURN-Dienst.
# ---------------------------------------------------------------------------
#STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478


# ---------------------------------------------------------------------------
# E-Mail: DIE BEIDEN SCHALTER  (OPTIONAL - die Vorgaben sind "wie bisher")
#
# Gelesen in class/Helper/MailGate.php. Erlaubte Schreibweisen fuer AN:
# 1, true, on, yes, ja. Fuer AUS: 0, false, off, no, nein. Alles andere gilt
# als nicht gesetzt und wird ins Log geschrieben - ein Vertipper stellt also
# nicht stillschweigend den Mailversand ab.
#
#
# MAIL_ENABLED  - wird tatsaechlich verschickt?   Vorgabe: an
#
#   AUS heisst NICHT "der Code ist abgeschaltet". Der gesamte Ablauf laeuft
#   unveraendert: Der Token wird angelegt, der Link gebaut, die
#   Bestaetigungsseite ausgegeben, die Bremse zaehlt mit. Nur die Verbindung
#   zum SMTP-Server unterbleibt - stattdessen landet die vollstaendige Mail
#   IM LOGFILE, mitsamt Link. Genau dort holt sich der Entwickler den
#   Bestaetigungs- bzw. Reset-Link, ohne dass ein SMTP-Server erreichbar sein
#   muss:
#
#     MAIL_ENABLED=aus - diese E-Mail wurde NICHT verschickt:
#       An:      d***k@example.com
#       Betreff: E-Mail-Adresse bestätigen
#       Text:
#         Hallo,
#         Bitte bestätige deine E-Mail durch Klick auf diesen Link:
#         https://.../index.php?act=verify_email&token=...
#
#   Damit der Link brauchbar ist, muss APP_BASE_URL gesetzt sein - auch bei
#   ausgeschaltetem Versand. Ohne die Basisadresse wird weder ein Token
#   angelegt noch etwas protokolliert (siehe oben).
#
#   Die vier SMTP_-Werte darunter werden bei AUS nicht gelesen. Eine
#   Entwicklungsinstallation ohne SMTP-Server braucht sie also nicht mehr
#   auszufuellen.
#
#
# MAIL_VERIFY_REQUIRED  - Pflicht zur Bestaetigung?   Vorgabe: aus
#
#   AN heisst: Ein Konto mit unbestaetigter Adresse darf sich anmelden und
#   alles lesen, aber NICHT
#     * eine Fuehrung anfragen        (Route request_create)
#     * einen Chat eroeffnen oder schreiben
#                                     (chat_start, chat_start_direct,
#                                      chat_send_message)
#     * Bilder hochladen              (upload_location_image,
#                                      guide_profile_save)
#   Die Liste steht in class/Helper/MailGate.php (PFLICHTROUTEN), geprueft
#   wird sie in index.php - an derselben Stelle wie jedes andere Zugangsrecht.
#
#   DIE ANMELDUNG SPERRT SIE AUSDRUECKLICH NICHT. Der Weg zu einer neuen
#   Bestaetigungsmail (Route send_email_verify) setzt eine Anmeldung voraus;
#   wer nicht hereinkommt, kaeme auch nie an eine neue Mail. Stattdessen steht
#   auf jeder Seite ein Hinweisstreifen mit dem Knopf "Bestätigungsmail
#   senden".
#
#   AUS heisst: alles wie bisher. user.email_verified wird gepflegt und
#   nirgends gefragt.
#
#
# WARUM ZWEI SCHALTER UND NICHT EINER
#
#   Weil sie zu verschiedenen Zeitpunkten scharf werden. In dem Moment, in
#   dem der Versand angeht, hat KEIN Bestandskonto eine bestaetigte Adresse -
#   es wurde ja nie eine Bestaetigungsmail verschickt. Ein gemeinsamer
#   Schalter wuerde also mit dem ersten Umlegen saemtliche Bestandskonten
#   aussperren.
#
#
# DER WEG AUF EINEN ECHTEN SERVER, in dieser Reihenfolge:
#
#   1. SMTP_-Werte und APP_BASE_URL eintragen, MAIL_ENABLED=1 setzen,
#      MAIL_VERIFY_REQUIRED weiter aus lassen. Ab jetzt bekommt jede neue
#      Registrierung ihre Bestaetigungsmail, und jedes Bestandskonto kann
#      sich ueber die Einstellungsseite eine schicken lassen.
#   2. Eine Frist abwarten und den Stand pruefen:
#         SELECT COUNT(*) FROM user WHERE deleted = 0 AND email_verified = 0;
#      Im Log stehen die betroffenen Anmeldungen mit Kennung
#      ("Anmeldung ohne bestaetigte E-Mail-Adresse").
#   3. ERST DANN MAIL_VERIFY_REQUIRED=1. Vorher pruefen, ob das eigene
#      Administrationskonto bestaetigt ist - es gibt keine Ausnahme fuer
#      Rollen. Notfalls von Hand:
#         UPDATE user SET email_verified = 1 WHERE id = <ID>;
# ---------------------------------------------------------------------------
MAIL_ENABLED=0
MAIL_VERIFY_REQUIRED=0


# ---------------------------------------------------------------------------
# E-Mail / SMTP  (PFLICHT, sobald MAIL_ENABLED an ist)
#
# Gelesen in class/Model/Email.php, verschickt ueber PHPMailer mit STARTTLS.
# SMTP_USERNAME dient zugleich als Absenderadresse.
#
# Fehlt einer der vier Werte, waehrend MAIL_ENABLED an ist, liefert
# "Passwort vergessen" HTTP 500. Der try/catch in Email.php faengt das NICHT
# ab, weil eine PHP-Warning keine Exception ist. Alle uebrigen Funktionen
# sind nicht betroffen.
#
# Bei MAIL_ENABLED=0 werden diese vier Werte gar nicht erst gelesen.
# ---------------------------------------------------------------------------
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=hier_das_smtp_passwort_eintragen


# ---------------------------------------------------------------------------
# Logging  (OPTIONAL - einziger Schluessel, der fehlen darf)
#
# Vollstaendiger Pfad zur Logdatei, ausgewertet in config/log_path.php:88.
# Fehlt der Wert, greift der Fallback ../logs/php-error.log, also ein
# Verzeichnis OBERHALB des Document Root. Das Verzeichnis wird beim ersten
# Schreiben automatisch mit den Rechten 0750 angelegt.
#
# ACHTUNG - hier in der .env wirkt der Wert NICHT:
#   index.php laedt config/error_handler.php in Zeile 3, config/env.php
#   aber erst in Zeile 9. Zum Zeitpunkt der Pfadermittlung ist die .env
#   also noch gar nicht eingelesen. LOG_PATH muss auf Server- oder
#   Systemebene gesetzt werden:
#     Apache : SetEnv LOG_PATH /var/log/webrtc/php-error.log
#     nginx  : fastcgi_param LOG_PATH /var/log/webrtc/php-error.log;
#     Docker : environment: LOG_PATH=/var/log/webrtc/php-error.log
#   Der Eintrag steht hier nur zur Dokumentation. Ohne ihn ist alles in
#   Ordnung - der Fallback greift.
# ---------------------------------------------------------------------------
#LOG_PATH=/var/log/webrtc/php-error.log


# ---------------------------------------------------------------------------
# Hochgeladene Bilder  (OPTIONAL)
#
# Basisverzeichnis fuer die hochgeladenen Bilder, ausgewertet in
# config/uploads.php. Fehlt der Wert, greift der Fallback ../uploads - also
# eine Ebene OBERHALB des Document Root, dieselbe Ebene wie das Log.
#
# ZWEI BAEUME LIEGEN DARUNTER:
#   <base>/locations/<location_id>/   die Bilder eines Standorts
#   <base>/guides/<user_id>/          das Avatarbild eines Guides
#
# WARUM AUSSERHALB DES WEBROOTS:
#   Eine hochgeladene Datei ist Fremdeingabe. Liegt sie unter dem Document
#   Root, ist sie ueber HTTP erreichbar, und was der Webserver mit ihr macht,
#   entscheidet dann seine Konfiguration und nicht die Anwendung. Ausgeliefert
#   werden die Bilder ausschliesslich ueber index.php?act=location_image bzw.
#   index.php?act=guide_avatar - Controller, die vorher pruefen, ob der
#   Standort gesperrt ist bzw. ob es das Bild ueberhaupt gibt.
#
# ANDERS ALS LOG_PATH wirkt dieser Wert hier in der .env:
#   config/uploads.php wird erst aus einem Controller heraus geladen, also
#   lange nachdem config/env.php die .env eingelesen hat. Ein Wert auf
#   Server- oder Systemebene (SetEnv, fastcgi_param, Docker) geht ebenfalls.
#
# Das Verzeichnis muss dem Webserver-Benutzer gehoeren und beschreibbar sein:
#   mkdir -p /var/lib/webrtc/uploads
#   chown www-data:www-data /var/lib/webrtc/uploads
#   chmod 750 /var/lib/webrtc/uploads
#
# Obergrenzen (Anzahl der Bilder je Standort, Dateigroesse, Masse - auch die
# des Avatarbildes) stehen NICHT hier, sondern in config/uploads.php - sie sind
# Anwendungslogik und keine Zugangsdaten.
# ---------------------------------------------------------------------------
#UPLOAD_PATH=/var/lib/webrtc/uploads


# ---------------------------------------------------------------------------
# HTTPS erzwingen  (OPTIONAL - Vorgabe: an)
#
# Ausgewertet in class/Helper/Https.php, gerufen in index.php ganz am Anfang.
#
# FORCE_HTTPS=1 (Vorgabe, auch wenn der Schluessel fehlt)
#   Jede Anfrage ueber http:// wird mit 301 auf https:// umgeleitet, und das
#   Sitzungscookie traegt das Merkmal "secure". Das ist das Verhalten aller
#   bisherigen Versionen - eine bestehende Installation merkt vom Schalter
#   nichts.
#
# FORCE_HTTPS=0
#   Keine Weiterleitung, und das Cookie kommt auch ueber http:// zurueck.
#   NUR FUER DIE LOKALE ENTWICKLUNG. Ohne diesen Schalter musste man dafuer
#   bisher vier Zeilen in index.php auskommentieren - und sie beim naechsten
#   Commit versehentlich mit hochladen.
#
#   Achtung: Kamera und Mikrofon gibt der Browser trotzdem nur in einem
#   "secure context" frei. http://localhost gilt als einer, http://192.168.x.x
#   nicht - ein Test vom Handy im selben WLAN braucht also ein Zertifikat,
#   auch wenn dieser Schalter aus ist.
#
# TRUST_PROXY  (Vorgabe: aus)
#   Nur einschalten, wenn ein Reverse-Proxy oder Load-Balancer davorsteht, der
#   TLS beendet und X-Forwarded-Proto setzt. Dann - und nur dann - glaubt die
#   Anwendung diesem Header.
#
#   AN, OBWOHL KEIN PROXY DAVORSTEHT: Jeder Aufrufer kann behaupten, seine
#   Klartextverbindung sei sicher; die Weiterleitung unterbleibt, und das
#   Sitzungscookie geht ueber http:// hinaus.
#   AUS, OBWOHL EIN PROXY DAVORSTEHT: PHP sieht nur http:// und leitet auf
#   https:// um, der Proxy reicht es wieder als http:// weiter - eine
#   Endlosschleife, bis der Browser abbricht.
# ---------------------------------------------------------------------------
FORCE_HTTPS=1
#TRUST_PROXY=0


# ---------------------------------------------------------------------------
# HSTS  (OPTIONAL - Vorgabe: aus)
#
# Strict-Transport-Security. Der Browser merkt sich fuer die angegebene Dauer,
# dass diese Domain nur ueber HTTPS zu erreichen ist, und laesst http:// gar
# nicht mehr zu - auch nicht mit Klick auf "trotzdem fortfahren".
#
# WARUM DIE VORGABE 0 IST: Ein gesendetes max-age laesst sich NICHT
# zurueckrufen. Laeuft das Zertifikat ab, zieht die Anwendung um oder wird die
# Domain fuer etwas anderes gebraucht, sperrt der Header die eigenen Benutzer
# aus - fuer die volle Dauer, die einmal geschickt wurde. Ein Header mit dieser
# Wirkung darf nicht als Nebenwirkung eines Updates entstehen.
#
# DER WEG DAHIN, in dieser Reihenfolge (ausfuehrlich in der README):
#   1. HTTPS laeuft, das Zertifikat erneuert sich automatisch, FORCE_HTTPS=1.
#   2. HSTS_MAX_AGE=300 - fuenf Minuten. Faellt etwas auf, ist es nach einer
#      Kaffeepause wieder vorbei.
#   3. HSTS_MAX_AGE=31536000 - ein Jahr, der uebliche Wert.
#
# HSTS_INCLUDE_SUBDOMAINS erst dann einschalten, wenn WIRKLICH JEDE Subdomain
# ein gueltiges Zertifikat hat - auch die eine, an die gerade niemand denkt.
#
# Kein preload-Schalter. Wer in die Vorabliste der Browser will, traegt seine
# Domain dort selbst ein; aus dieser Liste kommt man in Monaten wieder heraus,
# nicht in Minuten.
#
# Gesendet wird der Header nur ueber HTTPS - ueber http:// muss der Browser
# ihn ohnehin ignorieren.
# ---------------------------------------------------------------------------
HSTS_MAX_AGE=0
#HSTS_INCLUDE_SUBDOMAINS=0


# ---------------------------------------------------------------------------
# Content-Security-Policy  (OPTIONAL - Vorgabe: melden)
#
# Die Regel selbst steht in class/Helper/SecurityHeaders.php; hier steht nur,
# ob der Browser sie durchsetzen soll. Die uebrigen Sicherheitskopfzeilen
# (X-Frame-Options, X-Content-Type-Options, Referrer-Policy,
# Permissions-Policy) haben keinen Schalter - sie gelten immer.
#
# CSP_MODE=melden (Vorgabe)
#   Content-Security-Policy-Report-Only. Der Browser BLOCKIERT NICHTS und
#   schreibt jeden Verstoss in seine Konsole (F12 > Konsole).
#
# CSP_MODE=scharf
#   Der Browser blockiert. Erst einschalten, wenn die Konsole beim
#   Durchklicken der Anwendung - Karte, Standortseite, Verwaltung UND EIN
#   ECHTER ANRUF - keine Verstoesse mehr meldet.
#
# CSP_MODE=aus
#   Kein Header. Der Notausgang, falls die Regel im Betrieb doch etwas
#   blockiert und die Ursache nicht sofort zu finden ist.
#
# WARUM NICHT GLEICH SCHARF: Eine zu enge Regel legt die Anwendung lautlos
# lahm. Der heikelste Punkt ist nicht einmal sichtbar - Chrome prueft die
# TURN- und STUN-Server einer WebRTC-Verbindung gegen connect-src. Ein
# Vergessen dort nimmt keiner Seite ihr Aussehen, sondern jedem zweiten Anruf
# seine Verbindung.
# ---------------------------------------------------------------------------
CSP_MODE=melden


# ---------------------------------------------------------------------------
# Backups  (OPTIONAL - nur fuer deploy/backup/backup.sh)
#
# Das Skript sichert die Datenbank (mysqldump) und den Upload-Baum. Die
# Zugangsdaten holt es sich aus den DB_-Schluesseln weiter oben; hier stehen
# nur Ziel und Aufbewahrung. Die Anwendung selbst liest diese beiden Werte
# nicht.
#
# BACKUP_PATH
#   Zielverzeichnis. Fehlt der Wert, greift der Fallback ../backups - also
#   eine Ebene OBERHALB des Document Root, aus demselben Grund wie beim Log
#   und bei den Uploads: Ein Datenbankdump, den man sich ueber HTTP
#   herunterladen kann, ist der Ernstfall selbst. Das Skript setzt das
#   Verzeichnis auf 0700 und die Dateien auf 0600.
#
#   Ein Backup, das auf derselben Platte liegt wie die Datenbank, ueberlebt
#   einen Plattenausfall nicht. Der Pfad hier ist die halbe Miete; die andere
#   Haelfte ist eine Kopie auf ein anderes Geraet (rsync, Bandlaufwerk,
#   Objektspeicher) - siehe README, Abschnitt "Backups".
#
# BACKUP_KEEP_DAYS
#   Aufbewahrung in Tagen, Vorgabe 14. Geloescht wird ausschliesslich, was das
#   Skript selbst angelegt hat (db_*.sql.gz und uploads_*.tar.gz, ohne
#   Unterverzeichnisse). 0 heisst "nichts loeschen" - fuer den Fall, dass die
#   Aufbewahrung woanders geregelt ist.
# ---------------------------------------------------------------------------
#BACKUP_PATH=/var/backups/webrtc
#BACKUP_KEEP_DAYS=14


# ---------------------------------------------------------------------------
# APP_ENV  (WIRD NICHT VERWENDET)
#
# In der README als Schluessel aufgefuehrt, aber an keiner Stelle im Code
# ausgelesen. Der Eintrag steht hier auskommentiert, damit beim Vergleich
# mit der README nicht der Eindruck entsteht, er fehle versehentlich.
# Setzen oder Weglassen hat keinerlei Wirkung.
# ---------------------------------------------------------------------------
#APP_ENV=production
